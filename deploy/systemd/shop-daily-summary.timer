[Unit]
Description=Shop ERP — send the end-of-day summaries when each is due

[Timer]
# Every 5 minutes: the command sends the emails once DAILY_SUMMARY_TIME
# (default 21:30) has passed, and each owner's SMS at their own time
# (Shops console). Those times are TIME_ZONE (Africa/Dar_es_Salaam),
# whatever the server's clock.
OnCalendar=*:0/5
AccuracySec=1s

[Install]
WantedBy=timers.target
