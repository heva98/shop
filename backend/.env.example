SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Omit to use a local db.sqlite3. Point at Postgres for the real stack:
# DATABASE_URL=postgres://shop:shop@localhost:5432/shop
DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Production example (e.g. deploying to https://shop.example.com) ---
# SECRET_KEY=<a long random value — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))">
# DEBUG=False
# ALLOWED_HOSTS=shop.example.com
# CSRF_TRUSTED_ORIGINS=https://shop.example.com
# CORS_ALLOWED_ORIGINS=https://shop.example.com
# DATABASE_URL=postgres://shop:<password>@localhost:5432/shop
# The HTTPS flags below default to False — switch them on once TLS is live:
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# Leave SECURE_HSTS_SECONDS unset (0) until HTTPS is confirmed working end
# to end, then set e.g. 31536000 (1 year) to enable HSTS.
# SECURE_HSTS_SECONDS=0

# --- Operations (see deploy/README.md section 7) ---
# Nightly backups; /api/health/ fails when the newest is older than BACKUP_MAX_AGE_HOURS.
# BACKUP_DIR=/var/backups/shop
# BACKUP_KEEP=14
# BACKUP_MAX_AGE_HOURS=26
# Email: error alerts to ADMINS, and end-of-day summaries.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Shop ERP <alerts@example.com>
# ADMINS=Your Name:you@example.com
# SMS end-of-day summaries through Beem Africa.
# SMS_PROVIDER=beem
# BEEM_API_KEY=
# BEEM_SECRET_KEY=
# BEEM_SENDER_ID=INFO
# Sign-in rules.
# TOKEN_TTL_HOURS=14
# LOGIN_LOCKOUT_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
