SECRET_KEY=change-me
# DEBUG is off unless set here; never True in production.
DEBUG=True
# Development only (refused with DEBUG=False): with an SMS_BACKEND that
# sends nothing, show sign-up / password-reset codes on screen.
SHOW_SMS_CODES=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Omit to use a local db.sqlite3. Point at Postgres for the real stack:
# DATABASE_URL=postgres://shop:shop@localhost:5432/shop
DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Production example (e.g. deploying to https://shop.example.com) ---
# SECRET_KEY=<a long random value — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))">
# DEBUG=False
# ALLOWED_HOSTS=shop.example.com
# CSRF_TRUSTED_ORIGINS=https://shop.example.com
# CORS_ALLOWED_ORIGINS=https://shop.example.com
# DATABASE_URL=postgres://shop:<password>@localhost:5432/shop
# Switch the redirect on once TLS is live. Cookies are HTTPS-only whenever
# DEBUG=False; set these two False only to use /admin/ before TLS works:
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# Leave SECURE_HSTS_SECONDS unset (0) until HTTPS is confirmed working end
# to end, then set e.g. 31536000 (1 year) to enable HSTS.
# SECURE_HSTS_SECONDS=0

# --- Operations (see deploy/README.md section 7) ---
# Nightly backups; /api/health/ fails when the newest is older than BACKUP_MAX_AGE_HOURS.
# BACKUP_DIR=/var/backups/shop
# BACKUP_KEEP=14
# BACKUP_MAX_AGE_HOURS=26
# Email: error alerts to ADMINS, and end-of-day summaries.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Shop ERP <alerts@example.com>
# ADMINS=Your Name:you@example.com
# SMS: the owner's daily sales summary. Start with console to test, then
# notify_africa. noop (the default) saves the delivery log but sends nothing.
# SMS_BACKEND=notify_africa
# NOTIFY_AFRICA_BASE_URL=https://api.notify.africa
# NOTIFY_AFRICA_API_TOKEN=
# NOTIFY_AFRICA_SENDER_ID=          the numeric ID of the approved sender name
# NOTIFY_AFRICA_TIMEOUT=15
# Or, with SMS_BACKEND=beem:
# BEEM_API_KEY=
# BEEM_SECRET_KEY=
# BEEM_SENDER_ID=INFO
# SMS_MAX_SEGMENTS=3
# SMS_BATCH_RECIPIENT_CAP=500
# SMS_PROVIDER_CHUNK_SIZE=100
# SMS_PROVIDER_CHUNK_SLEEP=1.0
# SMS_PRICE_PER_SEGMENT=0           TZS per SMS part, for the cost estimate
# DAILY_SUMMARY_TIME=21:30          end-of-day emails, and the SMS of owners with no time of their own
# Sign-in rules (core/login_guard.py). Wrong passwords at the till's manager
# approval count too. Over LOGIN_LOCKOUT_MINUTES:
# TOKEN_TTL_HOURS=14
# LOGIN_LOCKOUT_ATTEMPTS=5           one username from one address
# LOGIN_LOCKOUT_GLOBAL_ATTEMPTS=20   one username from anywhere
# LOGIN_IP_LOCKOUT_ATTEMPTS=30       one address, any usernames
# LOGIN_LOCKOUT_MINUTES=15
# SUPERUSER_TOKEN_TTL_HOURS=4        platform administrators' sessions are shorter
# AUTH_THROTTLE_RATE=30/min          requests per address to sign-in, sign-up, password reset
# NUM_PROXIES=1                      proxies in front of gunicorn (2 behind Cloudflare + nginx)
# Security alerts to owners (deploy/systemd/shop-security-alerts.timer).
# OFFLINE_SALE_CLOCK_GRACE_MINUTES=15  an offline sale dated further outside its shift is reported
# OFFLINE_SALE_MAX_AGE_HOURS=48        ...as is one older than this when it arrives
# SECURITY_ALERTS_LOOKBACK_HOURS=24
# Self sign-up and "Forgot password?" send a code by SMS, so they need a real
# SMS_BACKEND in production. With DEBUG on and a backend that does not send
# (noop/console) and SHOW_SMS_CODES=True, the code is shown on screen instead, for testing.
# SIGNUP_OPEN=True                  False: shops are registered in the platform console only
# PHONE_CODE_MINUTES=10
# PHONE_CODE_ATTEMPTS=5
# PHONE_CODE_PER_PHONE_HOURLY=4
# PHONE_CODE_PER_IP_HOURLY=20
# --- Scaling out (see docs/scaling.md) ---
# Shared cache for the till catalog and rate limits; required with 2+ app servers.
# CACHE_URL=redis://localhost:6379/1
# Read replica for reports and analytics; unset = everything on the primary.
# DATABASE_REPLICA_URL=postgres://shop_ro:<password>@replica-host:5432/shop
# Per-client API ceilings (DRF rate syntax).
# THROTTLE_USER_RATE=1200/min
# THROTTLE_ANON_RATE=120/min
