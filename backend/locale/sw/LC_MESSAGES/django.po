# ── Django REST framework
msgid "\"{input}\" is not a valid choice."
msgstr "\"{input}\" si chaguo sahihi."

msgid "A server error occurred."
msgstr "Hitilafu imetokea kwenye seva."

msgid "A valid integer is required."
msgstr "Namba kamili sahihi inahitajika."

msgid "A valid number is required."
msgstr "Namba sahihi inahitajika."

msgid "Authentication credentials were not provided."
msgstr "Taarifa za kuingia hazikutolewa."

msgid "Date has wrong format. Use one of these formats instead: {format}."
msgstr "Tarehe ina muundo usio sahihi. Tumia mojawapo ya miundo hii: {format}."

msgid "Datetime has wrong format. Use one of these formats instead: {format}."
msgstr "Tarehe na saa vina muundo usio sahihi. Tumia mojawapo ya miundo hii: {format}."

msgid "Ensure that there are no more than {max_decimal_places} decimal places."
msgstr "Hakikisha hakuna zaidi ya nafasi {max_decimal_places} za desimali."

msgid "Ensure that there are no more than {max_digits} digits in total."
msgstr "Hakikisha hakuna zaidi ya tarakimu {max_digits} kwa jumla."

msgid "Ensure that there are no more than {max_whole_digits} digits before the decimal point."
msgstr "Hakikisha hakuna zaidi ya tarakimu {max_whole_digits} kabla ya nukta ya desimali."

msgid "Ensure this field has at least {min_length} characters."
msgstr "Hakikisha sehemu hii ina angalau herufi {min_length}."

msgid "Ensure this field has no more than {max_length} characters."
msgstr "Hakikisha sehemu hii haina zaidi ya herufi {max_length}."

msgid "Ensure this value is greater than or equal to {min_value}."
msgstr "Hakikisha thamani hii ni kubwa kuliko au sawa na {min_value}."

msgid "Ensure this value is less than or equal to {max_value}."
msgstr "Hakikisha thamani hii ni ndogo kuliko au sawa na {max_value}."

msgid "Enter a valid email address."
msgstr "Weka barua pepe sahihi."

msgid "Enter a valid URL."
msgstr "Weka URL sahihi."

msgid "Expected a list of items but got type \"{input_type}\"."
msgstr "Ilitarajiwa orodha ya vipengele lakini imepata aina \"{input_type}\"."

msgid "Expected available in {wait} second."
msgstr "Itapatikana baada ya sekunde {wait}."

msgid "Expected available in {wait} seconds."
msgstr "Itapatikana baada ya sekunde {wait}."

msgid "Incorrect authentication credentials."
msgstr "Taarifa za kuingia si sahihi."

msgid "Incorrect type. Expected pk value, received {data_type}."
msgstr "Aina si sahihi. Ilitarajiwa kitambulisho, imepokea {data_type}."

msgid "Invalid data. Expected a dictionary, but got {datatype}."
msgstr "Data si sahihi. Ilitarajiwa kamusi (dictionary), lakini imepata {datatype}."

msgid "Invalid input."
msgstr "Ingizo si sahihi."

msgid "Invalid page."
msgstr "Ukurasa si sahihi."

msgid "Invalid pk \"{pk_value}\" - object does not exist."
msgstr "Kitambulisho \"{pk_value}\" si sahihi - kitu hakipo."

msgid "Invalid token."
msgstr "Tokeni si sahihi."

msgid "Invalid token header. No credentials provided."
msgstr "Kichwa cha tokeni si sahihi. Hakuna taarifa za kuingia."

msgid "Invalid username/password."
msgstr "Jina la mtumiaji/nenosiri si sahihi."

msgid "Invalid value."
msgstr "Thamani si sahihi."

msgid "Malformed request."
msgstr "Ombi lina hitilafu."

msgid "Method \"{method}\" not allowed."
msgstr "Njia \"{method}\" hairuhusiwi."

msgid "Must be a valid UUID."
msgstr "Lazima iwe UUID sahihi."

msgid "Must be a valid boolean."
msgstr "Lazima iwe kweli au si kweli."

msgid "Must include \"username\" and \"password\"."
msgstr "Lazima ijumuishe \"username\" na \"password\"."

msgid "No file was submitted."
msgstr "Hakuna faili lililowasilishwa."

msgid "Not a valid string."
msgstr "Si maandishi sahihi."

msgid "Not found."
msgstr "Haikupatikana."

msgid "Request was throttled."
msgstr "Maombi ni mengi mno."

msgid "The submitted data was not a file. Check the encoding type on the form."
msgstr "Data iliyowasilishwa si faili. Angalia aina ya usimbaji kwenye fomu."

msgid "The submitted file is empty."
msgstr "Faili lililowasilishwa liko tupu."

msgid "This field may not be blank."
msgstr "Sehemu hii haiwezi kuwa tupu."

msgid "This field may not be null."
msgstr "Sehemu hii haiwezi kuwa tupu."

msgid "This field must be unique."
msgstr "Thamani ya sehemu hii lazima isijirudie."

msgid "The fields {field_names} must make a unique set."
msgstr "Sehemu {field_names} lazima ziwe na mchanganyiko usiojirudia."

msgid "This list may not be empty."
msgstr "Orodha hii haiwezi kuwa tupu."

msgid "Unsupported media type \"{media_type}\" in request."
msgstr "Aina ya maudhui \"{media_type}\" haitumiki kwenye ombi."

msgid "Upload a valid image. The file you uploaded was either not an image or a corrupted image."
msgstr "Pakia picha sahihi. Faili ulilopakia si picha au ni picha iliyoharibika."

msgid "User inactive or deleted."
msgstr "Mtumiaji amezimwa au amefutwa."

msgid "You do not have permission to perform this action."
msgstr "Huna ruhusa ya kufanya kitendo hiki."

msgid "Value must be valid JSON."
msgstr "Thamani lazima iwe JSON sahihi."

